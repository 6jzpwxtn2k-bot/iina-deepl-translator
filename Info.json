{
  "name": "DeepL Subtitle Translator",
  "identifier": "io.github.iina-deepl-translator",
  "version": "2.0.0",
  "description": "Mevcut altyaziyi DeepL ile Turkce veya Bulgarcaya cevirir, 2. track olarak yukler.",
  "author": {
    "name": "6jzpwxtn2k-bot",
    "url": "https://github.com/6jzpwxtn2k-bot/iina-deepl-translator"
  },
  "ghVersion": 2,
  "ghRepo": "6jzpwxtn2k-bot/iina-deepl-translator",
  "entry": "dist/index.js",
  "permissions": ["show-osd", "network-request", "file-system"],
  "allowedDomains": ["*"],
  "preferencesPage": "pref.html",
  "preferenceDefaults": {
    "apiKey": ""
  },
  "subtitleProviders": [
    { "id": "deepl-tr", "name": "DeepL: Turkceye Cevir" },
    { "id": "deepl-bg", "name": "DeepL: Bulgarcaya Cevir" }
  ]
}
